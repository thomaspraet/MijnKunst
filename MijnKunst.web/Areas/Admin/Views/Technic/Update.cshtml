@using MijnKunst.Models;
@model Technic

<div class="container px-5 py-4">

    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #84b133, #515c6a, #dfe057);">
            <h5 class="mb-0 fw-bold"><i class="bi bi-plus-lg me-2"></i>Bewerk techniek</h5>
            <p class="mb-0 small" style="color: #FFF;">Beheer technieken</p>
        </div>
        <div class="card-body px-5 p-4">
            <form method="post">
                <input type="hidden" name="Id" asp-for="Id" />
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Techniek naam</label>
                    <input type="text" name="Name" asp-for="Name" class="form-control" />
                    <span class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-outline-success fw-semibold me-2">Bewaar techniek</button>
                    <a asp-controller="Technic" asp-action="Index" class="btn btn-outline-secondary fw-medium">Annuleer</a>
                </div>
            </form>
        </div>
    </div>
</div>
