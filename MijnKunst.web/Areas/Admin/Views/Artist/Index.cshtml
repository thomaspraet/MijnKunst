@model IEnumerable<Artist>

<div class="container px-5 py-4">
        <div class="card border shadow-sm overflow-hidden">
            <div class="card-header text-white py-3 px-4 d-flex align-items-center justify-content-between" style="background: linear-gradient(to right, #84b133, #515c6a,#dfe057);">
                <div>
                    <h5 class="mb-0 fw-bold"><i class="bi bi-grid me-2"></i>Kunstenaars</h5>
                    <p class="mb-0 small" style="color: #FFF;">Beheer kunstenaars</p>
                </div>
                <a asp-controller="Artist" asp-action="Create" class="btn btn-sm btn-outline-light fw-semibold d-inline-flex align-items-center gap-1">
                <i class="bi bi-plus-lg"></i> Nieuwe kunstenaar
                </a>
            </div>
        <div class="table-responsive pt-3 px-5">
                <table class="table-styled">
                    <thead>
                        <tr>
                            <th>Artist First Name</th>
                            <th>Artist Last Name</th>
                            <th>Place of Birth</th>
                            <th>Year of Birth</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="p-5">
                        @foreach (var artist in Model.OrderBy(a => a.LastName))
                        {
                            <tr>
                                <td>@artist.FirstName</td>
                                <td>@artist.LastName</td>
                                <td>@artist.PlaceOfBirth</td>
                                <td>@artist.YearOfBirth</td>
                                <td class="text-end">
                                    <a asp-controller="Artist" asp-action="Update" asp-route-id="@artist.Id" class="btn btn-outline-success me-2">Bewerk</a>
                                    <a asp-controller="Artist" asp-action="Delete" asp-route-id="@artist.Id" class="btn btn-outline-danger">Verwijder</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
